# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VERCEL_AI_GATEWAY / AI_GATEWAY_API_KEY: Vercel AI Gateway API key (server-only).
AI_GATEWAY_API_KEY="MY_AI_GATEWAY_API_KEY"
VERCEL_AI_GATEWAY="MY_VERCEL_AI_GATEWAY_KEY"
CHAT_MODEL="nvidia/nemotron-3.5-lightning-free"
CHAT_MODEL_FALLBACKS="google/gemini-2.5-flash-lite,google/gemini-2.5-flash,openai/gpt-4o-mini"

# Shopify Headless Storefront & Admin API (server-only)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_SHOP_NAME="My Store"
SHOPIFY_CLIENT_ID="MY_SHOPIFY_CLIENT_ID"
SHOPIFY_CLIENT_SECRET="MY_SHOPIFY_CLIENT_SECRET"
SHOPIFY_ADMIN_API_ACCESS_TOKEN="MY_SHOPIFY_ADMIN_ACCESS_TOKEN"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="MY_SHOPIFY_STOREFRONT_ACCESS_TOKEN"
SHOPIFY_API_VERSION="2024-10"
SHOPIFY_STORE_CURRENCY="PKR"
SHOPIFY_STORE_COUNTRY="Pakistan"
SHOPIFY_REVALIDATE_SECRET="MY_REVALIDATE_SECRET"
